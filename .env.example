# Lola PA environment. Copy to .env and fill in real values. NEVER commit .env.

# -- LLM (Ollama Cloud, Hisham's key) --
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com/v1
EMBED_MODEL=nomic-embed-text
EXTRACT_MODEL=deepseek-v4.1-flash

# -- Fallback LLM, used when Ollama Cloud is down or rate-limited --
# Without a fallback the bot goes SILENT on a provider outage.
# Two spare keys are deliberate: a second Ollama key and/or OpenAI.
OLLAMA_FALLBACK_API_KEY=
OPENAI_API_KEY=

# -- Supabase (memory + event data, the SAME project) --
SUPABASE_MEMORY_URL=https://REPLACE_ME.supabase.co
SUPABASE_MEMORY_KEY=
# Postgres connection string, used for the events tables
SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.REPLACE_ME.supabase.co:5432/postgres

# -- Telegram gateway (Hisham's bot) --
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
GATEWAY_ALLOW_ALL_USERS=false

# -- GitHub (optional: repo access for the agent. Not needed for day-to-day events work) --
GITHUB_TOKEN=
GITHUB_USER=

# -- Google Calendar MCP (Railway: base64 of the local files) --
# GCP_OAUTH_KEYS_B64=
# GCAL_TOKENS_B64=

# -- Backups (daily cron to Supabase Storage; defaults shown, both optional) --
HERMES_BACKUP_BUCKET=hermes-backups
HERMES_BACKUP_KEEP=14

# -- Composio (Gmail, Google Calendar, Sheets, WhatsApp, ...) --
# Get the key: composio.dev dashboard home page (starts with ck_)
MCP_COMPOSIO_API_KEY=

# -- Timezone (informational; the authoritative value is config.yaml) --
TZ=Africa/Cairo

